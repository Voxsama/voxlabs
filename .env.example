# Copy to .env.local and fill in. The API key can also be set in the app's Settings page.
CARTESIA_API_KEY=sk_car_xxxxxxxxxxxxxxxx
CARTESIA_VERSION=2026-08-14
# Where the database and audio files are stored (default: ./data)
DATA_DIR=./data
# How many paragraphs generate at the same time
GEN_CONCURRENCY=3
# Optional: use your own ffmpeg instead of the bundled one
# FFMPEG_PATH=/usr/bin/ffmpeg

# Login: sessions are signed with this secret. If unset, a random one is stored in DATA_DIR/session-secret.
# SESSION_SECRET=change-me-to-a-long-random-string
# Set to 1 only for a private single-user install on your own PC (turns the login off).
# AUTH_DISABLED=1
